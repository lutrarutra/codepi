+/**
+ * Compact mode: per-turn transcript summaries for the interactive mode.
+ */
+import type { Container } from "@earendil-works/pi-tui";
+import type { AssistantMessage, Message, ToolResultMessage, UserMessage } from "@earendil-works/pi-ai";
+export interface CompactTurnSegment {
+    kind: "turn";
+    userMessage?: UserMessage;
+    /** Collapsed assistant/toolResult messages of the turn. */
+    entries: Message[];
+    /** Last assistant message of the turn without tool calls, if any. */
+    finalResponse?: AssistantMessage;
+}
+export interface CompactMessageSegment {
+    kind: "message";
+    message: Message;
+}
+export type CompactSegment = CompactTurnSegment | CompactMessageSegment;
+export interface CompactTurnStats {
+    input: number;
+    output: number;
+    reasoning: number;
+    cacheRead: number;
+    cacheWrite: number;
+    cost: number;
+    toolCalls: number;
+    toolFailures: number;
+    model: string | undefined;
+    latest: { kind: "thought" | "tool" | "output" | "aborted"; text: string } | undefined;
+}
+export interface CompactTurnSummaryOptions {
+    stats?: CompactTurnStats;
+    finished?: boolean;
+    startTime?: number;
+    endTime?: number;
+}
+export declare function formatTokenCount(count: number): string;
+export declare function formatCompactDuration(ms: number): string;
+export declare function summarizeToolCall(name: string, args: unknown): string;
+export declare function groupTurnsForCompact(messages: Message[]): CompactSegment[];
+export declare function aggregateCompactTurn(entries: Message[]): CompactTurnStats;
+export declare class CompactTurnSummary extends Container {
+    constructor(ui: { requestRender(): void }, initial?: CompactTurnSummaryOptions);
+    startTurn(): void;
+    setModel(model: string | undefined): void;
+    addThinkingDelta(delta: string): void;
+    noteToolCall(name: string, args: unknown, id?: string): void;
+    notePartialResult(partial: unknown): void;
+    toolEnded(name: string, isError: boolean): void;
+    addUsage(usage: { input?: number; output?: number; reasoning?: number; cacheRead?: number; cacheWrite?: number; cost?: { total?: number } }): void;
+    setFinished(aborted?: boolean): void;
+    applyStats(stats: CompactTurnStats): void;
+    dispose(): void;
+}
