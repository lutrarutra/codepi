@@ -0,0 +1,416 @@
+/**
+ * Compact mode: per-turn transcript summaries for the interactive mode.
+ *
+ * When compact mode is enabled, each turn renders as a single summary row
+ * (spinner, token/tool counts, cost, elapsed, model) plus the final response.
+ * This module holds the pure grouping/aggregation logic (unit-testable) and
+ * the CompactTurnSummary UI component.
+ */
+import { Container, Text } from "@earendil-works/pi-tui";
+import { theme } from "./theme/theme.js";
+
+// ============================================================================
+// Pure helpers
+// ============================================================================
+
+/** Format token counts for compact display (same style as the footer). */
+export function formatTokenCount(count) {
+    if (count < 1000)
+        return count.toString();
+    if (count < 10000)
+        return `${(count / 1000).toFixed(1)}k`;
+    if (count < 1000000)
+        return `${Math.round(count / 1000)}k`;
+    if (count < 10000000)
+        return `${(count / 1000000).toFixed(1)}M`;
+    return `${Math.round(count / 1000000)}M`;
+}
+
+/** Format a duration in milliseconds as "32s", "1m05s", "2h03m". */
+export function formatCompactDuration(ms) {
+    const totalSeconds = Math.max(0, Math.round(ms / 1000));
+    if (totalSeconds < 60)
+        return `${totalSeconds}s`;
+    const minutes = Math.floor(totalSeconds / 60);
+    const seconds = totalSeconds % 60;
+    if (minutes < 60)
+        return seconds > 0 ? `${minutes}m${String(seconds).padStart(2, "0")}s` : `${minutes}m`;
+    const hours = Math.floor(minutes / 60);
+    const remMinutes = minutes % 60;
+    return remMinutes > 0 ? `${hours}h${String(remMinutes).padStart(2, "0")}m` : `${hours}h`;
+}
+
+const ACTIVITY_ARG_KEYS = [
+    "pattern",
+    "command",
+    "path",
+    "file",
+    "dir",
+    "glob",
+    "query",
+    "url",
+    "name",
+    "title",
+    "message",
+    "id",
+];
+
+/** One-line description of a tool call for the muted "latest activity" line. */
+export function summarizeToolCall(name, args) {
+    let arg = "";
+    if (args && typeof args === "object") {
+        for (const key of ACTIVITY_ARG_KEYS) {
+            const value = args[key];
+            if (typeof value === "string" && value.trim()) {
+                arg = value.trim();
+                break;
+            }
+        }
+    }
+    return truncateActivity(arg ? `${name} ${arg}` : name);
+}
+
+function truncateActivity(text) {
+    const single = String(text).replace(/[\r\n\t]+/g, " ").trim();
+    return single.length > 120 ? `${single.slice(0, 117)}…` : single;
+}
+
+function firstLineOf(text) {
+    return truncateActivity(String(text).split("\n")[0]);
+}
+
+/**
+ * Group a context message list into segments for compact rendering.
+ *
+ * Returns an ordered list of segments preserving original order:
+ * - { kind: "message", message } for messages rendered as-is (user, custom,
+ *   compactionSummary, branchSummary, bashExecution, unknown roles)
+ * - { kind: "turn", userMessage, entries, finalResponse } where entries are the
+ *   collapsed assistant/toolResult messages and finalResponse is the last
+ *   assistant message of the turn that contains no tool calls (undefined when
+ *   the turn never produced a text response).
+ */
+export function groupTurnsForCompact(messages) {
+    const segments = [];
+    let turn = undefined;
+    const closeTurn = () => {
+        if (turn) {
+            segments.push(turn);
+            turn = undefined;
+        }
+    };
+    for (const message of messages) {
+        const role = message.role;
+        if (role === "assistant" || role === "toolResult") {
+            if (!turn) {
+                turn = { kind: "turn", userMessage: undefined, entries: [], finalResponse: undefined };
+            }
+            turn.entries.push(message);
+            if (role === "assistant") {
+                const hasToolCalls = message.content.some((c) => c.type === "toolCall");
+                // The final response is the last assistant message without tool
+                // calls; a subsequent tool-calling message supersedes it.
+                turn.finalResponse = hasToolCalls ? undefined : message;
+            }
+            continue;
+        }
+        closeTurn();
+        if (role === "user") {
+            turn = { kind: "turn", userMessage: message, entries: [], finalResponse: undefined };
+        }
+        else {
+            segments.push({ kind: "message", message });
+        }
+    }
+    closeTurn();
+    return segments;
+}
+
+/**
+ * Aggregate the collapsed messages of a turn into summary statistics.
+ * @param entries Assistant/toolResult messages belonging to the turn.
+ */
+export function aggregateCompactTurn(entries) {
+    let input = 0;
+    let output = 0;
+    let reasoning = 0;
+    let cacheRead = 0;
+    let cacheWrite = 0;
+    let cost = 0;
+    let toolCalls = 0;
+    let toolFailures = 0;
+    let model = undefined;
+    let latest = undefined;
+    for (const message of entries) {
+        if (message.role === "assistant") {
+            const usage = message.usage;
+            if (usage) {
+                input += usage.input || 0;
+                output += usage.output || 0;
+                reasoning += usage.reasoning || 0;
+                cacheRead += usage.cacheRead || 0;
+                cacheWrite += usage.cacheWrite || 0;
+                cost += usage.cost?.total || 0;
+            }
+            model = message.responseModel ?? message.model;
+            for (const content of message.content) {
+                if (content.type === "toolCall") {
+                    toolCalls++;
+                    latest = { kind: "tool", text: summarizeToolCall(content.name, content.arguments) };
+                }
+                else if (content.type === "thinking" && typeof content.thinking === "string" && content.thinking.trim()) {
+                    latest = { kind: "thought", text: firstLineOf(content.thinking) };
+                }
+            }
+        }
+        else if (message.role === "toolResult" && message.isError) {
+            toolFailures++;
+        }
+    }
+    return {
+        input,
+        output,
+        reasoning,
+        cacheRead,
+        cacheWrite,
+        cost,
+        toolCalls,
+        toolFailures,
+        model,
+        latest,
+    };
+}
+
+// ============================================================================
+// CompactTurnSummary component
+// ============================================================================
+
+/** Fg-color helper that degrades gracefully when the theme is not yet
+ * initialized (e.g. component constructed during tests or early startup). */
+function safeThemeFg(color, text) {
+    try {
+        return theme.fg(color, text);
+    }
+    catch {
+        return text;
+    }
+}
+
+const SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];
+const SPINNER_INTERVAL_MS = 80;
+
+/**
+ * Per-turn summary row shown in compact mode:
+ *   ⠋ ✓11 ✗1 tools · ↑12.3k ↓4.5k 🧠1.2k · $0.42 · 32s · model
+ *   latest thought / tool call line (text-muted)
+ *
+ * Live turns animate the spinner and elapsed time; finished turns render a
+ * static record. The component stays in the transcript after finishing.
+ */
+export class CompactTurnSummary extends Container {
+    constructor(ui, initial = {}) {
+        super();
+        this.ui = ui;
+        this.usage = { input: 0, output: 0, reasoning: 0, cacheRead: 0, cacheWrite: 0, cost: 0 };
+        this.toolsOk = 0;
+        this.toolsFail = 0;
+        this.toolsRunning = 0;
+        this.seenToolIds = new Set();
+        this.latestActivity = undefined;
+        this.model = undefined;
+        this.thinkingBuffer = "";
+        this.startedAt = initial.startTime;
+        this.endedAt = initial.endTime;
+        this.finished = false;
+        this.spinnerFrame = 0;
+        this.spinnerInterval = undefined;
+        this.statsLine = new Text("", 1, 0);
+        this.activityLine = new Text("", 2, 0);
+        this.addChild(this.statsLine);
+        this.addChild(this.activityLine);
+        if (initial.stats) {
+            this.applyStats(initial.stats);
+        }
+        if (initial.finished) {
+            this.finished = true;
+        }
+        this.updateStatsLine();
+    }
+
+    /** Begin a live turn: reset counters and start spinner/elapsed. */
+    startTurn() {
+        this.finished = false;
+        this.startedAt = Date.now();
+        this.endedAt = undefined;
+        this.spinnerFrame = 0;
+        this.toolsOk = 0;
+        this.toolsFail = 0;
+        this.toolsRunning = 0;
+        this.seenToolIds = new Set();
+        this.startSpinner();
+    }
+
+    setModel(model) {
+        if (model && model !== this.model) {
+            this.model = model;
+            this.updateStatsLine();
+        }
+    }
+
+    /** Feed a thinking_delta while the model is reasoning. */
+    addThinkingDelta(delta) {
+        if (!delta)
+            return;
+        this.thinkingBuffer = `${this.thinkingBuffer}${delta}`.slice(-600);
+        this.latestActivity = { kind: "thought", text: firstLineOf(this.thinkingBuffer) };
+        this.updateStatsLine();
+    }
+
+    /**
+     * A tool call was emitted (may still be running).
+     *
+     * `id` is the tool call id (content block id / execution toolCallId). The
+     * streaming layer re-emits the whole message on every delta, so the same
+     * call is reported many times; only the first sighting increments the
+     * running counter, later ones just refresh the activity line.
+     */
+    noteToolCall(name, args, id) {
+        if (!id || !this.seenToolIds.has(id)) {
+            if (id)
+                this.seenToolIds.add(id);
+            this.toolsRunning++;
+        }
+        this.latestActivity = { kind: "tool", text: summarizeToolCall(name, args) };
+        this.updateStatsLine();
+    }
+
+    /** Partial streaming output from a running tool. */
+    notePartialResult(partial) {
+        if (!partial || typeof partial !== "object")
+            return;
+        const textContent = partial.content?.find?.((c) => c.type === "text");
+        if (textContent && typeof textContent.text === "string" && textContent.text.trim()) {
+            this.latestActivity = { kind: "output", text: firstLineOf(textContent.text) };
+            this.updateStatsLine();
+        }
+    }
+
+    /** A tool finished executing. */
+    toolEnded(_name, isError) {
+        this.toolsRunning = Math.max(0, this.toolsRunning - 1);
+        if (isError) {
+            this.toolsFail++;
+        }
+        else {
+            this.toolsOk++;
+        }
+        this.updateStatsLine();
+    }
+
+    /** Accumulate token usage from an assistant message. */
+    addUsage(usage) {
+        if (!usage)
+            return;
+        this.usage.input += usage.input || 0;
+        this.usage.output += usage.output || 0;
+        this.usage.reasoning += usage.reasoning || 0;
+        this.usage.cacheRead += usage.cacheRead || 0;
+        this.usage.cacheWrite += usage.cacheWrite || 0;
+        this.usage.cost += usage.cost?.total || 0;
+        this.updateStatsLine();
+    }
+
+    /** Stop the spinner and freeze the summary as a static record. */
+    setFinished(aborted) {
+        if (this.finished)
+            return;
+        this.finished = true;
+        this.endedAt = Date.now();
+        this.stopSpinner();
+        if (aborted && !this.latestActivity) {
+            this.latestActivity = { kind: "aborted", text: "aborted" };
+        }
+        this.updateStatsLine();
+    }
+
+    applyStats(stats) {
+        this.usage = {
+            input: stats.input || 0,
+            output: stats.output || 0,
+            reasoning: stats.reasoning || 0,
+            cacheRead: stats.cacheRead || 0,
+            cacheWrite: stats.cacheWrite || 0,
+            cost: stats.cost || 0,
+        };
+        this.toolsOk = Math.max(0, (stats.toolCalls || 0) - (stats.toolFailures || 0));
+        this.toolsFail = stats.toolFailures || 0;
+        this.model = stats.model;
+        this.latestActivity = stats.latest;
+        if (stats.latest?.kind === "thought") {
+            this.thinkingBuffer = stats.latest.text;
+        }
+    }
+
+    dispose() {
+        this.stopSpinner();
+    }
+
+    startSpinner() {
+        this.stopSpinner();
+        this.spinnerInterval = setInterval(() => {
+            this.spinnerFrame = (this.spinnerFrame + 1) % SPINNER_FRAMES.length;
+            this.updateStatsLine();
+        }, SPINNER_INTERVAL_MS);
+    }
+
+    stopSpinner() {
+        if (this.spinnerInterval) {
+            clearInterval(this.spinnerInterval);
+            this.spinnerInterval = undefined;
+        }
+    }
+
+    getStatsText() {
+        const parts = [];
+        if (!this.finished) {
+            parts.push(safeThemeFg("accent", SPINNER_FRAMES[this.spinnerFrame] ?? ""));
+        }
+        if (this.toolsOk > 0 || this.toolsFail > 0 || this.toolsRunning > 0) {
+            const toolParts = [];
+            if (this.toolsOk > 0)
+                toolParts.push(safeThemeFg("success", `✓${this.toolsOk}`));
+            if (this.toolsFail > 0)
+                toolParts.push(safeThemeFg("error", `✗${this.toolsFail}`));
+            if (!this.finished && this.toolsRunning > 0)
+                toolParts.push(safeThemeFg("accent", `…${this.toolsRunning}`));
+            parts.push(`${toolParts.join(" ")}${safeThemeFg("dim", " tools")}`);
+        }
+        const tokens = [];
+        if (this.usage.input > 0)
+            tokens.push(safeThemeFg("success", "↑") + safeThemeFg("text", formatTokenCount(this.usage.input)));
+        if (this.usage.output > 0)
+            tokens.push(safeThemeFg("error", "↓") + safeThemeFg("text", formatTokenCount(this.usage.output)));
+        if (this.usage.reasoning > 0)
+            tokens.push(safeThemeFg("accent", "🧠") + safeThemeFg("text", formatTokenCount(this.usage.reasoning)));
+        if (tokens.length > 0)
+            parts.push(tokens.join(" "));
+        if (this.usage.cost > 0)
+            parts.push(safeThemeFg("warning", `$${this.usage.cost.toFixed(2)}`));
+        if (this.startedAt) {
+            const end = this.endedAt ?? Date.now();
+            parts.push(formatCompactDuration(end - this.startedAt));
+        }
+        if (this.model)
+            parts.push(safeThemeFg("accent", this.model));
+        return parts.join(safeThemeFg("dim", " · "));
+    }
+
+    updateStatsLine() {
+        const text = this.getStatsText();
+        this.statsLine.setText(text ? ` ${text}` : "");
+        this.activityLine.setText(this.latestActivity ? safeThemeFg("muted", this.latestActivity.text) : "");
+        if (this.ui) {
+            this.ui.requestRender();
+        }
+    }
+}
