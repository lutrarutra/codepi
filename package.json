{
  "name": "codepi",
  "displayName": "CodePi",
  "description": "Pi coding agent for VSCode",
  "version": "0.1.0",
  "publisher": "lutrarutra",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "CodePi",
      "properties": {
        "codepi.piPath": {
          "type": "string",
          "default": "",
          "description": "Path to custom pi SDK or pi binary. Leave empty to use bundled pi."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codepi-sessions",
          "title": "PI",
          "icon": "./media/pi-icon.svg"
        }
      ]
    },
    "views": {
      "codepi-sessions": [
        {
          "id": "codepi.sessionsList",
          "name": "Sessions"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "codepi.chat",
        "displayName": "CodePi Chat",
        "selector": [
          {
            "filenamePattern": "*.codepi-chat"
          }
        ],
        "priority": "default"
      }
    ],
    "icons": {
      "codepi-logo": {
        "description": "CodePi (pi) logo",
        "default": {
          "fontPath": "./media/codepi-logo.woff",
          "fontCharacter": "\ue000"
        }
      }
    },
    "colors": [
      {
        "id": "codepi.logo",
        "description": "CodePi logo color (tab handle) — white on dark themes, dark on light themes so it stays visible",
        "defaults": {
          "dark": "#ffffff",
          "light": "#1f1f1f",
          "highContrast": "#ffffff"
        }
      }
    ],
    "commands": [
      {
        "command": "codepi.openPanel",
        "title": "CodePi: Open Chat"
      },
      {
        "command": "codepi.openSession",
        "title": "Open Session"
      },
      {
        "command": "codepi.renameSession",
        "title": "Rename Session"
      },
      {
        "command": "codepi.deleteSession",
        "title": "Delete Session"
      },
      {
        "command": "codepi.newSession",
        "title": "New Session",
        "icon": "$(plus)"
      },
      {
        "command": "codepi.refreshSessions",
        "title": "Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "codepi.acceptHunk",
        "title": "CodePi: Accept Edit Hunk",
        "icon": "$(check)"
      },
      {
        "command": "codepi.rejectHunk",
        "title": "CodePi: Reject Edit Hunk",
        "icon": "$(close)"
      },
      {
        "command": "codepi.acceptFile",
        "title": "CodePi: Accept All Edits in File",
        "icon": "$(check-all)"
      },
      {
        "command": "codepi.rejectFile",
        "title": "CodePi: Reject All Edits in File",
        "icon": "$(discard)"
      },
      {
        "command": "codepi.acceptAllEdits",
        "title": "CodePi: Accept All Edits",
        "icon": "$(check-all)"
      },
      {
        "command": "codepi.rejectAllEdits",
        "title": "CodePi: Reject All Edits",
        "icon": "$(discard)"
      },
      {
        "command": "codepi.openDiff",
        "title": "CodePi: Open Edit Diff",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codepi.newSession",
          "when": "view == codepi.sessionsList",
          "group": "navigation"
        },
        {
          "command": "codepi.refreshSessions",
          "when": "view == codepi.sessionsList",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codepi.renameSession",
          "when": "view == codepi.sessionsList && viewItem == session"
        },
        {
          "command": "codepi.deleteSession",
          "when": "view == codepi.sessionsList && viewItem == session"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:webview && npm run build:extension",
    "build:extension": "node esbuild.mjs --production",
    "build:webview": "npm --prefix webview-ui run build",
    "watch": "concurrently -n webview,ext \"npm:watch:webview\" \"npm:watch:extension\"",
    "watch:extension": "node esbuild.mjs",
    "watch:webview": "npm --prefix webview-ui run dev",
    "lint": "tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.1",
    "@vscode/ripgrep-universal": "^1.18.0",
    "openai": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
