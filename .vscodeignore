# node_modules: the extension host requires pi's full production dependency
# closure at runtime, so it has to ship. pi 1.0 hoists that closure to the root
# (0.87.x nested it under pi-coding-agent), which is why every production
# package is allowlisted explicitly — an omitted package means the released
# extension dies at activation with "Cannot find package ...". The list below
# is the installed production closure of package-lock.json; src/__tests__/
# packaging-allowlist.test.ts fails when it drifts from the lockfile.
node_modules
!node_modules/@anthropic-ai/**
!node_modules/@aws/lambda-invoke-store/**
!node_modules/@aws-sdk/**
!node_modules/@babel/**
!node_modules/@earendil-works/**
!node_modules/@google/**
!node_modules/@protobufjs/**
!node_modules/@smithy/**
!node_modules/@stablelib/**
!node_modules/@types/node/**
!node_modules/@types/retry/**
!node_modules/@vscode/**
