{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run CodePi Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api=lutrarutra.codepi",
        "--disable-extensions"
      ],
    }
  ]
}